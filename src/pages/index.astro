---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Join from '../components/Join.astro';
import {CLUB,url} from '../data/club';
---
<Layout><section class="hero"><div class="hero-media"><video id="hero-video" poster={url('media/poster.jpg')} data-desktop={url('media/hero-desktop.mp4')} data-mobile={url('media/hero-mobile.mp4')} muted autoplay loop playsinline preload="none" aria-label="KU Car Club evening gathering"></video><div class="film-label"><i></i> KU CAR CLUB — AFTER HOURS</div><button id="video-toggle" class="video-toggle">Play background video ▷</button></div><div class="hero-content"><p class="eyebrow">THE CARS BRING US TOGETHER.</p><h1>KU CAR CLUB<span>ONE PASSION.<br/>ENDLESS CONNECTIONS.</span></h1><p class="hero-tagline">Learn, Experience, Connect.</p><div class="actions" id="hero-cta"><a class="button yellow" data-join href={CLUB.whatsapp}>Join the club <span>↗</span></a><a class="button outline" href={url('gallery/')}>Explore the gallery <span>↗</span></a></div></div><div class="hero-bottom"><span>A COMMUNITY. A CONVERSATION. A SHARED PASSION.</span><a href="#community">DISCOVER THE CLUB ↓</a></div></section><section class="values wrap" aria-label="Club values">{[['01','LEARN','Every car has a story.'],['02','EXPERIENCE','See the passion up close.'],['03','CONNECT','Find your kind of people.']].map(([n,t,p])=><div><span>{n}</span><h2>{t}<small>{p}</small></h2><span class="value-arrow">↗</span></div>)}</section><section id="community" class="wrap split section"><div class="section-copy"><p class="eyebrow">THIS IS KU CAR CLUB</p><h2>IT STARTS WITH CARS.<br/>IT’S ABOUT PEOPLE.</h2><p>The details that make you look twice. The conversations that keep you around. A shared appreciation for everything automotive.</p><p>KU Car Club brings that passion together. Learn something new, experience the cars, and connect with the people behind them.</p><a class="text-link" href={url('about/')}>Meet the community <span>↗</span></a></div><div class="community-photo"><Photo n={21}/><span class="image-caption">THE PEOPLE BEHIND THE PASSION.</span></div></section><section class="dark section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">THE CLUB, THROUGH OUR LENS</p><h2>MOMENTS THAT<br/>BRING US TOGETHER.</h2></div><a class="text-link" href={url('gallery/')}>All club moments ↗</a></div><div class="moment-grid">{[{n:8,title:'After hours',tag:'After dark',sub:'WHEN THE LIGHTS COME ON'},{n:16,title:'Up close',tag:'After dark',sub:'IT’S ALL IN THE DETAILS'},{n:21,title:'Good company',tag:'In focus',sub:'MORE THAN THE MACHINES'}].map(m=><a class="moment-card" href={url(`gallery/?filter=${encodeURIComponent(m.tag)}`)}><Photo n={m.n}/><div><p class="eyebrow">{m.sub}</p><h3>{m.title}<span>↗</span></h3></div></a>)}</div></div></section><section class="wrap section"><div class="section-heading"><div><p class="eyebrow">A FEW THAT CAUGHT OUR EYE</p><h2>IN GOOD COMPANY.</h2></div><a class="text-link" href={url('gallery/')}>Explore the gallery ↗</a></div><div class="featured">{[17,18,20,22].map(n=><a href={url('gallery/')} aria-label="Explore car photographs"><Photo n={n}/></a>)}</div><p class="caption">A selection from the KU Car Club photo collection.</p></section><section class="events-banner"><div class="wrap"><p class="eyebrow">THE NEXT CHAPTER</p><h2>SEE YOU AT<br/>THE NEXT GATHERING.</h2><p>Follow @ku.car.club for the next gathering and the latest club updates.</p><a class="button yellow" href={CLUB.instagram}>Follow on Instagram <span>↗</span></a><a class="text-link" href={url('events/')}>Club updates ↗</a></div></section><section class="wrap section film-section"><div class="section-heading"><div><p class="eyebrow">TURN UP THE ATMOSPHERE</p><h2>AN EVENING WITH KU.</h2></div><span class="caption">THE CLUB FILM / 00:33</span></div><div class="full-film"><video id="full-film" data-src={url('media/club-film.mp4')} poster={url('media/poster.jpg')} preload="none" playsinline aria-label="Full KU Car Club evening film"></video><button id="film-play" class="button yellow">▷ Play the club film</button><noscript><a class="button yellow" href={url('media/club-film.mp4')}>Watch the film ↗</a></noscript></div></section><Join/></Layout>
