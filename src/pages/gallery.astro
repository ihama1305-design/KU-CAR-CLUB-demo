---
import Layout from '../layouts/Layout.astro'; import Photo from '../components/Photo.astro'; import media from '../data/media.json'; import {url} from '../data/club';
---
<Layout title="Gallery"><section class="wrap section"><div class="section-heading"><div><p class="eyebrow">THE KU PHOTO COLLECTION</p><h1>PASSION. IN FRAME.</h1></div><p>Cars, details, and the people<br/>who bring it all together.</p></div><div class="filters" aria-label="Filter photographs">{['All','After dark','In focus'].map((tag,i)=><button data-filter={tag} aria-pressed={i===0?'true':'false'}>{tag}</button>)}</div><p id="gallery-count" aria-live="polite">{media.length} photographs</p><div class="gallery">{media.map((m,i)=><a class="gallery-item" data-tag={m.tag} href={url(`media/${m.id}.jpg`)} data-caption={m.alt}><Photo n={i+1}/><span>{m.tag}<span>↗</span></span></a>)}</div><p id="gallery-empty" hidden>No photographs in this selection. Try another filter.</p></section><dialog id="lightbox" aria-label="Photograph viewer"><div class="lightbox-bar"><span id="lightbox-position"></span><button id="lightbox-close" autofocus>Close ✕</button></div><img id="lightbox-image" alt=""/><div class="lightbox-bottom"><button id="lightbox-prev" aria-label="Previous photograph">←</button><p id="lightbox-caption"></p><button id="lightbox-next" aria-label="Next photograph">→</button></div></dialog></Layout>
