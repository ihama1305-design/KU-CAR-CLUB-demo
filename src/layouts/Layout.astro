---
import '../styles/global.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import {CLUB,url} from '../data/club';
interface Props {title?: string; description?:string;}
const {title='Learn. Experience. Connect.',description='A shared passion for cars. Discover KU Car Club, explore club moments, and connect with the community.'}=Astro.props;
const production=!!import.meta.env.SITE;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#161817"/><title>{title} | KU Car Club</title><meta name="robots" content={production?'index,follow':'noindex,nofollow'}/>{production && <link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/>}<meta property="og:title" content={`${title} | KU Car Club`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:image" content={production?new URL(url('media/local-08.jpg'),Astro.site).href:url('media/local-08.jpg')}/><link rel="icon" type="image/svg+xml" href={url('favicon.svg')}/><noscript><style>.menu-toggle,#video-toggle,#film-play,.filters{display:none!important}.header{flex-wrap:wrap}.header nav{display:flex!important;position:static;flex-wrap:wrap;flex-direction:row;box-shadow:none;padding:0;width:100%}.header nav a{padding:14px}.header .nav-join{margin:0}</style></noscript></head><body><a class="skip" href="#main">Skip to content</a><header class="header"><a href={url()} class="brand" aria-label="KU Car Club home"><b>KU<span> / </span></b><span>CAR<br/>CLUB</span></a><span class="brand-tag">LEARN. EXPERIENCE. CONNECT.</span><button class="menu-toggle" aria-controls="navigation" aria-expanded="false">Menu <span>☰</span></button><nav id="navigation" aria-label="Main navigation">{['About','Events','Gallery'].map(label=><a aria-current={Astro.url.pathname.endsWith(`/${label.toLowerCase()}/`)?'page':undefined} href={url(`${label.toLowerCase()}/`)}>{label}</a>)}<a href={CLUB.instagram} aria-label="KU Car Club on Instagram">Instagram ↗</a><a class="nav-join" data-join href={CLUB.whatsapp}>Join the club ↗</a></nav></header><main id="main"><slot/></main><footer><div class="wrap footer-top"><a class="brand light" href={url()}><b>KU<span> / </span></b><span>CAR<br/>CLUB</span></a><p>Learn, Experience, Connect.</p><a href={CLUB.instagram}>@ku.car.club ↗</a></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} KU Car Club</span><nav aria-label="Footer navigation"><a href={url('about/')}>About</a><a href={url('events/')}>Events</a><a href={url('gallery/')}>Gallery</a><a href={url('join/')}>Join QR</a></nav><span>DRIVEN BY A SHARED PASSION.</span></div></footer><a class="floating-join" data-join href={CLUB.whatsapp} hidden>Join on WhatsApp ↗</a><script>import '../scripts/site';</script></body></html>

